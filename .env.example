# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Which provider the harness uses by default: anthropic | gemini
LLM_PROVIDER=anthropic

# Optional model overrides (defaults live in core/llm.py)
# ANTHROPIC_MODEL_STRONG=claude-opus-5
# ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5
# GEMINI_MODEL_STRONG=gemini-3.1-pro
# GEMINI_MODEL_CHEAP=gemini-3.8-flash
